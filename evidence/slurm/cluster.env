# ---------------------------------------------------------------------------
# cluster.env: Plaksha HPC (https://hpc.plaksha.edu.in), GENERAL access.
# Sourced by setup_env.sh, submit.sh and every *.sbatch job.
#   general QoS: partition rtx only · 1 GPU per user · 2 running / 10 submitted jobs · 12 h max
#   rtx GPUs = RTX PRO 6000 slices: gpu:1g.24gb (4 on cn03), gpu:2g.48gb (2 on cn02). h200 is faculty/paid only.
#   General jobs can be PREEMPTED (requeued) by course/faculty/rfphd/paid jobs after 10 min.
# ---------------------------------------------------------------------------

# SLURM placement (passed on the sbatch command line, overrides #SBATCH lines)
PARTITION="rtx"
ACCOUNT="general"
QOS="general"
GRES="gpu:1g.24gb:1"       # H1 (Qwen2.5-0.5B). Use gpu:2g.48gb:1 if H1 is switched to Qwen2.5-1.5B
GRES_BIG="gpu:1g.24gb:1"   # H2 (Qwen2.5-3B): full FT OOM on 24 GB is the point; QLoRA fits
GRES_SMALL="gpu:1g.24gb:1" # check, H3, H4

# Software, the cluster's documented way: `module load python` provides Python 3.13 + PyTorch 2.13 (cu130)
# built for these GPUs. Our venv reuses it (--system-site-packages); pip adds only the small extras.
# Never pip-install torch into it (the guide says so, and big pip writes to /home fail on master1).
MODULES="python"
VENV="$HOME/envs/peft"

# Storage: /home is backed up but has a 20 GB quota; /scratch is huge, NOT backed up, purged without warning.
# Re-creatable bulk (model cache, checkpoints) goes to /scratch; code, results/ and logs/ stay in /home.
HF_HOME="/scratch/$USER/hf_cache"
CKPT_ROOT="/scratch/$USER/peft_ckpts"

# 1 = jobs use only the pre-downloaded cache (compute-node internet is not documented; offline is the safe default)
OFFLINE=1
